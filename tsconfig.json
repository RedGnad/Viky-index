{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "src/**/*.ts",
    "envio-env.d.ts",
    "scripts/**/*.ts"
  ]
}
