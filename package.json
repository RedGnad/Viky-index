{
  "name": "viky-index",
  "version": "0.1.0",
  "private": true,
  "description": "Viky's gifts, days, payouts and refunds on Monad, indexed from the contracts' own events with Envio HyperIndex",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "stop": "envio stop",
    "typecheck": "tsc --noEmit",
    "count:chain": "python3 scripts/count-on-chain.py",
    "compare:counts": "tsx scripts/compare-counts.ts",
    "check:gifts": "tsx scripts/check-gifts-on-chain.ts"
  },
  "dependencies": {
    "envio": "3.12.1"
  },
  "devDependencies": {
    "ethers": "6.17.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
